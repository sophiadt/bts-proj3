*.mb filter=lfs diff=lfs merge=lfs -text
# Capture data: never line-ending-convert (a depth .bin with no zero byte would look like text)
captures/**/*.bin binary
captures/**/*.jpg binary
captures/**/*.png binary
captures/**/*.zip binary
# template_export/: exported meshes, fits and pictures are binary
template_export/**/*.npz binary
template_export/**/*.png binary
template_export/**/*.gif binary
